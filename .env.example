# ── Required ─────────────────────────────────────────────────────────────────
# Get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: OpenRouter fallback ────────────────────────────────────────────
# If Gemini returns a 429 (quota exhausted), Talky automatically retries with
# perplexity/sonar-pro on OpenRouter, which also has built-in web search.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Optional: model overrides ─────────────────────────────────────────────────
# Primary model (Gemini). Default: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
# Fallback model (OpenRouter). Default: perplexity/sonar
OPENROUTER_MODEL=perplexity/sonar

# ── Optional: port ────────────────────────────────────────────────────────────
PORT=3000
